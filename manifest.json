{
  "manifest_version": 3,
  "name": "Loudness & VU Meter",
  "version": "1.0.0",
  "description": "YouTube / HLS などブラウザで再生中の音声を、プレーヤー音量に依存せずラウドネス(LUFS・True Peak)とVUで計測します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Loudness & VU Meter を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "permissions": ["sidePanel", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/dsp.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/dsp.js", "src/worklet.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
